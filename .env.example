LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LOCAL_LLM=
LOCAL_LLM_TIMEOUT=150

# Hosting: set these on the backend (see docs/DEPLOYMENT.md).
# APP_ENV=production
# DATA_DIR=/var/lib/gramsahayak
# ALLOWED_ORIGINS=https://your-frontend.example
# Vercel build only: BACKEND_ORIGIN=https://your-backend.example

# Optional replacement map providers. Use compatible endpoints and respect their policies.
GEOCODER_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Translation providers (optional; Bhashini is default per GoI priority)
VITE_TRANSLATION_PROVIDER=bhashini
VITE_BHASHINI_USER_ID=
VITE_BHASHINI_API_KEY=
VITE_BHASHINI_PIPELINE_ID=
VITE_GOOGLE_TRANSLATE_API_KEY=

